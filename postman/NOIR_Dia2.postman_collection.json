{
  "info": {
    "name": "NOIR — Día 2: autenticación y CRUD",
    "description": "Pruebas API para importar en Postman. Ejecutar en orden. Crea datos QA propios y guarda ids/tokens en variables de colección; no requiere borrar registros existentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "email", "value": "" }, { "key": "password", "value": "NoirDemo_2026!" },
    { "key": "token", "value": "" }, { "key": "categoryId", "value": "" },
    { "key": "supplierId", "value": "" }, { "key": "productId", "value": "" }
  ],
  "item": [
    { "name": "01 — Registrar usuario QA (201)", "event": [{ "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('email', 'noir.qa.' + Date.now() + '@example.test');"] } }, { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 y usuario público sin hash', () => { pm.response.to.have.status(201); const b=pm.response.json(); pm.expect(b.usuario).to.have.property('id'); pm.expect(b.usuario).not.to.have.property('password'); pm.expect(b.usuario).not.to.have.property('hash'); });"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"NOIR QA\",\n  \"correo\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/register" } },
    { "name": "02 — Correo duplicado (400)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('correo duplicado responde 400', () => pm.response.to.have.status(400));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nombre\":\"NOIR QA\",\"correo\":\"{{email}}\",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/register" } },
    { "name": "03 — Registro inválido (400)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('datos inválidos responden 400', () => pm.response.to.have.status(400));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nombre\":\"\",\"correo\":\"no-es-correo\",\"password\":\"123\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/register" } },
    { "name": "04 — Login válido y guardar JWT (200)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 y JWT', () => { pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.token).to.be.a('string'); pm.expect(b.usuario).not.to.have.property('password'); pm.collectionVariables.set('token', b.token); });"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"correo\":\"{{email}}\",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" } },
    { "name": "05 — Credenciales incorrectas (401)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"correo\":\"{{email}}\",\"password\":\"incorrecta\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" } },
    { "name": "06 — Perfil sin token (401)", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 sin token', () => pm.response.to.have.status(401));"] } }] },
    { "name": "07 — Perfil con JWT (200)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/auth/me" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 y usuario sin hash', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().usuario).not.to.have.property('password'); });"] } }] },
    { "name": "08 — Token mal formado (401)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer invalido.no.jwt" }], "url": "{{baseUrl}}/auth/me" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 token inválido', () => pm.response.to.have.status(401));"] } }] },
    { "name": "09 — CRUD Categorías / crear (201)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nombre\":\"QA {{email}}\",\"descripcion\":\"Registro de prueba Postman\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/categorias" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 categoría', () => { pm.response.to.have.status(201); pm.collectionVariables.set('categoryId', pm.response.json().data.id); });"] } }] },
    { "name": "10 — Categorías sin token (401)", "request": { "method": "GET", "url": "{{baseUrl}}/categorias" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }] },
    { "name": "11 — CRUD Categorías / listar y leer por id (200)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/categorias/{{categoryId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 categoría', () => pm.response.to.have.status(200));"] } }] },
    { "name": "12 — Categorías / actualizar (200)", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"descripcion\":\"Actualizada por pruebas QA\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/categorias/{{categoryId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 actualización', () => pm.response.to.have.status(200));"] } }] },
    { "name": "13 — Categorías / id inexistente (404)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/categorias/999999999" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404', () => pm.response.to.have.status(404));"] } }] },
    { "name": "14 — CRUD Proveedores / crear (201)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nombre\":\"QA {{email}}\",\"correo\":\"{{email}}\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/proveedores" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 proveedor', () => { pm.response.to.have.status(201); pm.collectionVariables.set('supplierId', pm.response.json().data.id); });"] } }] },
    { "name": "15 — Proveedores / listar (200)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/proveedores" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 lista', () => pm.response.to.have.status(200));"] } }] },
    { "name": "16 — Proveedores / leer por id (200)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/proveedores/{{supplierId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 proveedor', () => pm.response.to.have.status(200));"] } }] },
    { "name": "17 — Proveedores / actualizar (200)", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"telefono\":\"8888-0000\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/proveedores/{{supplierId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 actualización', () => pm.response.to.have.status(200));"] } }] },
    { "name": "18 — CRUD Productos / crear (201)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nombre\":\"Producto QA {{email}}\",\"descripcion\":\"Prueba automatizada\",\"precio\":10,\"stock\":1,\"categoria_id\":{{categoryId}},\"proveedor_id\":{{supplierId}}}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/productos" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('201 producto', () => { pm.response.to.have.status(201); pm.collectionVariables.set('productId', pm.response.json().data.id); });"] } }] },
    { "name": "19 — Productos / FK inválida (400)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"nombre\":\"FK inválida\",\"precio\":10,\"stock\":1,\"categoria_id\":999999999,\"proveedor_id\":{{supplierId}}}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/productos" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 FK no existente', () => pm.response.to.have.status(400));"] } }] },
    { "name": "20 — Productos / listar (200)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/productos" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 lista', () => pm.response.to.have.status(200));"] } }] },
    { "name": "21 — Productos / leer por id (200)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/productos/{{productId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 producto', () => pm.response.to.have.status(200));"] } }] },
    { "name": "22 — Productos / actualizar (200)", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"stock\":2}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/productos/{{productId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 actualización', () => pm.response.to.have.status(200));"] } }] },
    { "name": "23 — Categoría relacionada no se elimina (409)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/categorias/{{categoryId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 integridad referencial', () => pm.response.to.have.status(409));"] } }] },
    { "name": "24 — Productos / eliminar QA (204)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/productos/{{productId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 producto eliminado', () => pm.response.to.have.status(204));"] } }] },
    { "name": "25 — Categorías / eliminar QA (204)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/categorias/{{categoryId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 categoría eliminada', () => pm.response.to.have.status(204));"] } }] },
    { "name": "26 — Proveedores / eliminar QA (204)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/proveedores/{{supplierId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('204 proveedor eliminado', () => pm.response.to.have.status(204));"] } }] },
    { "name": "27 — Categorías / listar (200)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/categorias" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 lista de categorías', () => pm.response.to.have.status(200));"] } }] },
    { "name": "28 — Desbloqueo sin código activo (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"correo\":\"{{email}}\",\"codigo\":\"000000\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/verify-unlock" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 sin un desbloqueo válido', () => pm.response.to.have.status(400));"] } }] },
    { "name": "29 — Reenvío sin bloqueo activo (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"correo\":\"{{email}}\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/resend-unlock" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 sin bloqueo activo', () => pm.response.to.have.status(400));"] } }] },
    { "name": "30 — Cambio sin permiso temporal (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"correo\":\"{{email}}\",\"passwordResetToken\":\"invalid\",\"password\":\"NoirDemo_2026!\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/reset-password" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 sin permiso temporal', () => pm.response.to.have.status(400));"] } }] },
    { "name": "31 — Omitir cambio sin permiso temporal (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"correo\":\"{{email}}\",\"passwordResetToken\":\"invalid\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/skip-password-reset" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 sin permiso temporal', () => pm.response.to.have.status(400));"] } }] }
  ]
}
